{
  "name": "agente-editorial",
  "version": "1.0.0",
  "description": "Agente Editorial automático para blog sobre IA, No-Code, LLMs, Vibe Coding",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "run:once": "tsx src/index.ts --once",
    "run:now": "tsx src/index.ts --now"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cron": "^3.1.7",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.4.0",
    "feedparser": "^2.2.10",
    "he": "^1.2.0",
    "marked": "^12.0.2",
    "openai": "^4.52.0",
    "p-limit": "^6.1.0",
    "pg": "^8.21.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/feedparser": "^2.2.9",
    "@types/he": "^1.2.3",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.11.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
