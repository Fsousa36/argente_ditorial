# === CONFIGURAÇÕES DA API OPENAI ===
OPENAI_API_KEY=sk-sua-chave-aqui

# === CONFIGURAÇÕES DO BLOG (WordPress via REST API ou JSON) ===
BLOG_TYPE=json       # "wordpress" | "json"
BLOG_URL=https://seudominio.com
BLOG_API_KEY=sua-chave-wordpress-aqui  # Apenas para WordPress

# === CONFIGURAÇÕES DO ARQUIVO JSON (se BLOG_TYPE=json) ===
OUTPUT_DIR=./published

# === CONFIGURAÇÕES DO AGENDAMENTO ===
# Cron: primeiro parâmetro (minuto), segundo (hora), terceiro (dia do mês), quarto (mês), quinto (dia da semana)
# Exemplo: "0 */6 * * *" = a cada 6 horas
CRON_SCHEDULE=0 */6 * * *

# === CONFIGURAÇÕES DO AGENTE ===
MAX_ARTICLES_PER_RUN=3
LANGUAGE=pt-BR
AUDIENCE_MODE=technical   # "technical" | "beginner" | "mixed"
INCLUDE_IMAGES=true

# === FONTES DE NOTÍCIAS (RSS) ===
# Lista separada por vírgula
RSS_FEEDS=https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml,https://www.theverge.com/ai-artificial-intelligence/rss/index.xml,https://techcrunch.com/category/artificial-intelligence/feed/,https://www.artificialintelligence-news.com/feed/,https://venturebeat.com/category/ai/feed/
