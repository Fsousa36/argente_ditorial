# === TAMBÉM GERA ARQUIVOS LOCAIS (fallback) ===
OUTPUT_DIR=./published
BLOG_TYPE=json

# === CONFIGURAÇÕES DO AGENDAMENTO ===
# A cada 6 horas
CRON_SCHEDULE=0 */6 * * *

# === CONFIGURAÇÕES DO CONTEÚDO ===
MAX_ARTICLES_PER_RUN=3
LANGUAGE=pt-BR
AUDIENCE_MODE=mixed
INCLUDE_IMAGES=true

